DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rally_courts

# Host/port the FastAPI server binds to (used by the Dockerfile's CMD; for
# local, non-Docker dev pass them to uvicorn yourself, e.g.
# `uv run uvicorn app.main:app --host $HOST --port $PORT --reload`)
HOST=0.0.0.0
PORT=8000

# Comma-separated list of origins allowed to call this API (the frontend's
# own host:port)
CORS_ORIGINS=http://localhost:5173