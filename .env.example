# Copy to `.env` to override the host/port each service in docker-compose.yml
# binds to and is reached at. Docker Compose loads this file automatically.
# Leave unset to keep the defaults (db:5432, backend:8000, frontend:5173).

# DB_PORT=5432

# BACKEND_HOST=0.0.0.0
# BACKEND_PORT=8000

# FRONTEND_HOST=0.0.0.0
# FRONTEND_PORT=5173

# Origins allowed to call the backend API, and the URL the frontend calls it
# at. Override these together if you change BACKEND_PORT/FRONTEND_PORT above
# or deploy to a non-localhost host.
# CORS_ORIGINS=http://localhost:5173
# VITE_API_BASE_URL=http://localhost:8000
